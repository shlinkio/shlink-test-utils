{
    "name": "shlinkio/shlink-test-utils",
    "type": "project",
    "homepage": "https://shlink.io",
    "description": "Testing utils for Shlink",
    "license": "MIT",
    "authors": [
        {
            "name": "Alejandro Celaya Alastrué",
            "homepage": "https://www.alejandrocelaya.com",
            "email": "alejandro@alejandrocelaya.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "doctrine/data-fixtures": "^1.8",
        "doctrine/orm": "^3.6",
        "fig/http-message-util": "^1.1",
        "guzzlehttp/guzzle": "^7.11",
        "phpunit/php-code-coverage": "^14.0",
        "phpunit/phpunit": "^13.2",
        "psr/container": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "shlinkio/shlink-json": "^1.2",
        "symfony/console": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/process": "^8.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.30",
        "shlinkio/shlink-mago-config": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Shlinkio\\Shlink\\TestUtils\\": "src"
        }
    },
    "scripts": {
        "ci": ["@cs", "@analyze"],
        "lint": "mago lint",
        "lint:fix": "mago lint --fix",
        "format": "mago format",
        "format:check": "mago format --check",
        "cs": ["@lint", "@format:check"],
        "cs:fix": ["@lint:fix", "@format"],
        "analyze": "mago analyze",
        "stan": "@analyze"
    },
    "scripts-descriptions": {
        "ci": "<fg=blue;options=bold>Alias for \"cs\" and \"analyze\"</>",
        "cs": "<fg=blue;options=bold>Checks coding styles</>",
        "cs:fix": "<fg=blue;options=bold>Fixes coding styles, when possible</>",
        "analyze": "<fg=blue;options=bold>Inspects code with mago analyze</>"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
